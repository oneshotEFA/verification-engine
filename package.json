{
  "name": "@localpay/verification-engine",
  "version": "0.1.0",
  "description": "Bank receipt verification engine for Ethiopian and East African banks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "localpay",
    "verification",
    "bank",
    "receipt",
    "ethiopia",
    "africa"
  ],
  "author": "LocalPay",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "dependencies": {
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "https-proxy-agent": "^7.0.2",
    "jsdom": "^28.1.0",
    "pdf-parse": "^1.1.4",
    "socks-proxy-agent": "^8.0.5",
    "tesseract.js": "^7.0.0"
  },
  "peerDependencies": {
    "puppeteer": "^24.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "puppeteer": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
