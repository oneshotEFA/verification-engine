{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "tests/boa.spec.ts",
    "tests/cbe-validator.spec.ts",
    "tests/ebirr.spec.ts",
    "tests/telebirr.spec.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
